<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <%= link_to "← Back to #{@quiz.course.title}", teacher_course_path(@quiz.course), class: "text-xs font-semibold text-blue-600 hover:text-blue-800 uppercase tracking-wider" %>
        <h1 class="text-2xl font-bold text-blue-950 mt-1"><%= @quiz.title %></h1>
        <% if @quiz.passing_score.present? %>
          <p class="text-sm text-slate-500 mt-1">Passing score: <%= @quiz.passing_score.to_i %>%</p>
        <% end %>
      </div>
      <div class="space-x-3">
        <%= link_to "Edit", edit_teacher_quiz_path(@quiz), class: "px-4 py-2 text-sm font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg transition-colors" %>
        <%= link_to "Delete", teacher_quiz_path(@quiz), data: { turbo_method: :delete, turbo_confirm: "Delete this quiz and all its slides?" }, class: "px-4 py-2 text-sm font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-lg transition-colors" %>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-blue-950">Slides (<%= @slides.count %>)</h3>
        <%= link_to "+ New Slide", new_teacher_quiz_slide_path(@quiz), class: "px-3 py-1.5 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg" %>
      </div>

      <% if @slides.any? %>
        <div class="divide-y divide-slate-100">
          <% @slides.each_with_index do |slide, index| %>
            <div class="py-3 flex items-center justify-between">
              <div>
                <%= link_to "#{index + 1}. #{slide.title}", teacher_slide_path(slide), class: "text-sm font-medium text-slate-900 hover:text-blue-600" %>
                <p class="text-xs text-slate-500"><%= slide.slide_questions.size %> question<%= "s" unless slide.slide_questions.size == 1 %></p>
              </div>
              <div class="space-x-3">
                <%= link_to "Edit", edit_teacher_slide_path(slide), class: "text-blue-600 hover:text-blue-800 text-xs font-medium" %>
                <%= link_to "Delete", teacher_slide_path(slide), data: { turbo_method: :delete, turbo_confirm: "Delete this slide?" }, class: "text-rose-600 hover:text-rose-800 text-xs font-medium" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-500">No slides yet.</p>
      <% end %>
    </div>
  </div>
</div>
