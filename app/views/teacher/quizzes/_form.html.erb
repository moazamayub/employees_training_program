<%= form_with(model: [:teacher, quiz],
      url: (quiz.persisted? ? teacher_quiz_path(quiz) : teacher_course_quizzes_path(@course)),
      class: "space-y-6") do |form| %>
  <% if quiz.errors.any? %>
    <div class="rounded-xl bg-rose-50 border border-rose-200 p-4 mb-6">
      <h3 class="text-sm font-semibold text-rose-800">
        <%= pluralize(quiz.errors.count, "error") %> prohibited this quiz from saving:
      </h3>
      <ul class="mt-2 ml-7 list-disc text-xs text-rose-700 space-y-1">
        <% quiz.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= form.text_field :title, class: "w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" %>
  </div>

  <div>
    <%= form.label :passing_score, "Passing score (%)", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= form.number_field :passing_score, min: 0, max: 100, class: "w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-5 border-t border-slate-200">
    <%= link_to "Cancel", (quiz.persisted? ? teacher_quiz_path(quiz) : teacher_course_path(@course)), class: "px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors shadow-sm" %>
    <%= form.submit class: "px-5 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors shadow-sm cursor-pointer" %>
  </div>
<% end %>
