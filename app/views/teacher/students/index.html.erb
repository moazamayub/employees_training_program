<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-5xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-blue-950">Students</h1>
      <%= link_to "+ New Student", new_teacher_student_path, class: "inline-flex items-center px-4 py-2.5 rounded-lg text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition-colors" %>
    </div>

    <% if @students.any? %>
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 divide-y divide-slate-100">
        <% @students.each do |student| %>
          <div class="p-4 flex items-center justify-between">
            <div>
              <%= link_to [student.first_name, student.last_name].compact.join(" ").presence || student.email, teacher_student_path(student), class: "text-sm font-semibold text-slate-900 hover:text-blue-600" %>
              <p class="text-xs text-slate-500"><%= student.email %> &middot; <%= student.user_courses.size %> course<%= "s" unless student.user_courses.size == 1 %> enrolled</p>
            </div>
            <div class="space-x-3">
              <%= link_to "Edit", edit_teacher_student_path(student), class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
              <%= link_to "Delete", teacher_student_path(student), data: { turbo_method: :delete, turbo_confirm: "Remove #{student.email}?" }, class: "text-rose-600 hover:text-rose-800 text-sm font-medium" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16 bg-white rounded-xl border border-slate-200 shadow-sm">
        <h3 class="text-base font-semibold text-slate-900">No students yet</h3>
        <p class="mt-1 text-sm text-slate-500">Add your first student to get started.</p>
        <div class="mt-6">
          <%= link_to "New Student", new_teacher_student_path, class: "inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
