<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <%= link_to "← Back to Students", teacher_students_path, class: "text-xs font-semibold text-blue-600 hover:text-blue-800 uppercase tracking-wider" %>
        <h1 class="text-2xl font-bold text-blue-950 mt-1"><%= [@student.first_name, @student.last_name].compact.join(" ").presence || @student.email %></h1>
        <p class="text-sm text-slate-500 mt-1"><%= @student.email %></p>
      </div>
      <div class="space-x-3">
        <%= link_to "Edit", edit_teacher_student_path(@student), class: "px-4 py-2 text-sm font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg transition-colors" %>
        <%= link_to "Delete", teacher_student_path(@student), data: { turbo_method: :delete, turbo_confirm: "Remove this student?" }, class: "px-4 py-2 text-sm font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-lg transition-colors" %>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
      <h3 class="text-lg font-semibold text-blue-950 mb-4">Enrolled Courses (<%= @enrollments.count %>)</h3>
      <% if @enrollments.any? %>
        <div class="divide-y divide-slate-100">
          <% @enrollments.each do |enrollment| %>
            <div class="py-3 flex items-center justify-between">
              <div>
                <%= link_to enrollment.course.title, teacher_course_path(enrollment.course), class: "text-sm font-medium text-slate-900 hover:text-blue-600" %>
                <p class="text-xs text-slate-500">
                  <%= enrollment.status.titleize %> &middot; <%= number_to_percentage(enrollment.progress_percentage || 0, precision: 0) %> complete
                </p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-500">Not enrolled in any courses yet.</p>
      <% end %>
    </div>
  </div>
</div>
