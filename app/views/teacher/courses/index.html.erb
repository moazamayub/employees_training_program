<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <!-- Header Section -->
    <div class="mb-8 border-b border-blue-100 pb-5">
      <h1 class="text-3xl font-bold tracking-tight text-blue-950">Instructor Course Management</h1>
      <p class="mt-2 text-sm text-slate-500">Overview of courses and enrolled employee/student performance</p>
    </div>
    
    <% if @courses.any? %>
      <div class="space-y-8">
        <% @courses.each do |course| %>
          <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <!-- Course Summary Header -->
            <div class="p-6 bg-gradient-to-r from-blue-50 to-white border-b border-blue-100 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
              <div>
                <h3 class="text-xl font-semibold text-blue-900"><%= course.title %></h3>
                <% if course.description.present? %>
                  <p class="mt-1 text-sm text-slate-600 max-w-3xl"><%= course.description %></p>
                <% end %>
              </div>
              <div class="flex items-center gap-2 flex-wrap">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">
                  <%= course.user_courses.size %> Enrolled
                </span>
                <% if course.company.present? %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
                    <%= course.company.name %>
                  </span>
                <% end %>
              </div>
            </div>

            <!-- Enrolled Students Performance Table -->
            <div class="p-6">
              <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-4">Enrolled Students</h4>

              <% if course.user_courses.any? %>
                <div class="overflow-x-auto rounded-lg border border-slate-200">
                  <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
                    <thead class="bg-slate-50 text-slate-700">
                      <tr>
                        <th scope="col" class="px-4 py-3 font-semibold">Student Name</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Email</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Status</th>
                        <th scope="col" class="px-4 py-3 font-semibold w-1/4">Progress</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Score</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Enrolled Date</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Completed Date</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 bg-white">
                      <% course.user_courses.each do |user_course| %>
                        <% student = user_course.user %>
                        <% progress = user_course.progress_percentage || 0 %>

                        <tr class="hover:bg-blue-50/40 transition-colors">
                          <!-- User Name -->
                          <td class="px-4 py-3.5 font-medium text-slate-900 whitespace-nowrap">
                            <%= [student.first_name, student.last_name].compact.join(" ").presence || "User ##{student.id}" %>
                          </td>

                          <!-- User Email -->
                          <td class="px-4 py-3.5 text-slate-600 whitespace-nowrap"><%= student.email %></td>

                          <!-- UserCourse Status -->
                          <td class="px-4 py-3.5 whitespace-nowrap">
                            <% status_badge_classes = case user_course.status
                               when "completed" then "bg-emerald-50 text-emerald-700 border-emerald-200"
                               when "in_progress" then "bg-blue-50 text-blue-700 border-blue-200"
                               when "failed" then "bg-rose-50 text-rose-700 border-rose-200"
                               else "bg-slate-100 text-slate-700 border-slate-200"
                               end %>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border <%= status_badge_classes %>">
                              <%= user_course.status.present? ? user_course.status.to_s.titleize : "Enrolled" %>
                            </span>
                          </td>

                          <!-- Progress Percentage Bar -->
                          <td class="px-4 py-3.5 whitespace-nowrap">
                            <div class="flex items-center gap-3">
                              <div class="w-full bg-slate-200 rounded-full h-2 overflow-hidden">
                                <div class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: <%= [progress, 100].min %>%;"></div>
                              </div>
                              <span class="text-xs font-semibold text-slate-700 w-10 text-right">
                                <%= number_to_percentage(progress, precision: 0) %>
                              </span>
                            </div>
                          </td>

                          <!-- Score -->
                          <td class="px-4 py-3.5 whitespace-nowrap">
                            <% if user_course.score.present? %>
                              <span class="font-semibold text-blue-900"><%= user_course.score %>%</span>
                            <% else %>
                              <span class="text-slate-400">—</span>
                            <% end %>
                          </td>

                          <!-- Enrolled At -->
                          <td class="px-4 py-3.5 text-slate-500 whitespace-nowrap">
                            <%= (user_course.enrolled_at || user_course.created_at).strftime("%b %d, %Y") %>
                          </td>

                          <!-- Completed At -->
                          <td class="px-4 py-3.5 text-slate-500 whitespace-nowrap">
                            <%= user_course.completed_at&.strftime("%b %d, %Y") || "—" %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% else %>
                <div class="text-center py-6 border-2 border-dashed border-slate-200 rounded-lg">
                  <p class="text-sm text-slate-500">No students enrolled in this course yet.</p>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="text-center py-16 bg-white rounded-xl border border-slate-200 shadow-sm">
        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <h3 class="mt-3 text-sm font-semibold text-slate-900">No courses available</h3>
        <p class="mt-1 text-sm text-slate-500">No courses were found for this account.</p>
      </div>
    <% end %>
  </div>
</div>