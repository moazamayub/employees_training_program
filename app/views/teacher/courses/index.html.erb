<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-5xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-blue-950">Courses</h1>
      <%= link_to "+ New Course", new_teacher_course_path, class: "inline-flex items-center px-4 py-2.5 rounded-lg text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition-colors" %>
    </div>

    <% if @courses.any? %>
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 divide-y divide-slate-100">
        <% @courses.each do |course| %>
          <div class="p-4 flex items-center justify-between">
            <div>
              <%= link_to course.title, teacher_course_path(course), class: "text-sm font-semibold text-slate-900 hover:text-blue-600" %>
              <p class="text-xs text-slate-500"><%= course.user_courses.size %> enrolled</p>
            </div>
            <div class="space-x-3">
              <%= link_to "Edit", edit_teacher_course_path(course), class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
              <%= link_to "Delete", teacher_course_path(course), data: { turbo_method: :delete, turbo_confirm: "Delete #{course.title}?" }, class: "text-rose-600 hover:text-rose-800 text-sm font-medium" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16 bg-white rounded-xl border border-slate-200 shadow-sm">
        <h3 class="text-base font-semibold text-slate-900">No courses yet</h3>
        <p class="mt-1 text-sm text-slate-500">Create your first course to get started.</p>
        <div class="mt-6">
          <%= link_to "New Course", new_teacher_course_path, class: "inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
