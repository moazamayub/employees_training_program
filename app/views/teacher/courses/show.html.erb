<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <%= link_to "← Back to Courses", teacher_courses_path, class: "text-xs font-semibold text-blue-600 hover:text-blue-800 uppercase tracking-wider" %>
        <h1 class="text-2xl font-bold text-blue-950 mt-1"><%= @course.title %></h1>
        <% if @course.description.present? %>
          <p class="text-sm text-slate-500 mt-1"><%= @course.description %></p>
        <% end %>
      </div>
      <div class="space-x-3">
        <%= link_to "Edit", edit_teacher_course_path(@course), class: "px-4 py-2 text-sm font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg transition-colors" %>
        <%= link_to "Delete", teacher_course_path(@course), data: { turbo_method: :delete, turbo_confirm: "Delete this course?" }, class: "px-4 py-2 text-sm font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-lg transition-colors" %>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex items-center justify-between">
      <div>
        <h3 class="text-lg font-semibold text-blue-950">Quiz Content</h3>
        <p class="text-sm text-slate-500 mt-1"><%= @course.quizzes.size %> quiz<%= "zes" unless @course.quizzes.size == 1 %></p>
      </div>
      <%= link_to "Manage Quizzes →", teacher_course_quizzes_path(@course), class: "text-sm font-semibold text-blue-600 hover:text-blue-800" %>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
      <h3 class="text-lg font-semibold text-blue-950 mb-4">Enroll a Student</h3>
      <% if @available_students.any? %>
        <%= form_with url: teacher_course_enrollments_path(@course), method: :post, class: "flex gap-3" do |f| %>
          <%= f.select :user_id, @available_students.map { |s| [[s.first_name, s.last_name].compact.join(" ").presence || s.email, s.id] }, { include_blank: "Select a student..." }, class: "flex-1 rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm" %>
          <%= f.submit "Enroll", class: "px-4 py-2.5 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700" %>
        <% end %>
      <% else %>
        <p class="text-sm text-slate-500">All students in your company are already enrolled, or none exist yet.</p>
      <% end %>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
      <h3 class="text-lg font-semibold text-blue-950 mb-4">Enrolled Students (<%= @enrollments.count %>)</h3>
      <% if @enrollments.any? %>
        <div class="divide-y divide-slate-100">
          <% @enrollments.each do |enrollment| %>
            <div class="py-3 flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-slate-900"><%= [enrollment.user.first_name, enrollment.user.last_name].compact.join(" ").presence || enrollment.user.email %></p>
                <p class="text-xs text-slate-500">
                  <%= enrollment.status.titleize %> &middot; enrolled <%= enrollment.enrolled_at&.strftime("%b %d, %Y") || enrollment.created_at.strftime("%b %d, %Y") %>
                </p>
              </div>
              <%= link_to "Unenroll", teacher_course_enrollment_path(@course, enrollment), data: { turbo_method: :delete, turbo_confirm: "Unenroll this student?" }, class: "text-rose-600 hover:text-rose-800 text-sm font-medium" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-500">No students enrolled yet.</p>
      <% end %>
    </div>
  </div>
</div>
