<%= form_with(model: [:teacher, slide_question],
      url: (slide_question.persisted? ? teacher_slide_question_path(slide_question) : teacher_slide_slide_questions_path(@slide)),
      class: "space-y-6") do |form| %>
  <% if slide_question.errors.any? %>
    <div class="rounded-xl bg-rose-50 border border-rose-200 p-4 mb-6">
      <h3 class="text-sm font-semibold text-rose-800">
        <%= pluralize(slide_question.errors.count, "error") %> prohibited this question from saving:
      </h3>
      <ul class="mt-2 ml-7 list-disc text-xs text-rose-700 space-y-1">
        <% slide_question.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :question_text, "Question", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= form.text_area :question_text, rows: 2, class: "w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :question_type, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.select :question_type, SlideQuestion.question_types.keys.map { |t| [t.titleize, t] }, {}, class: "w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm" %>
    </div>
    <div>
      <%= form.label :points, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.number_field :points, min: 0, class: "w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm" %>
    </div>
  </div>

  <div class="space-y-3">
    <h4 class="text-sm font-semibold text-slate-700">
      Options &mdash; check the box next to the correct answer(s)
    </h4>
    <p class="text-xs text-slate-500">
      Single/True-False questions need exactly one correct option; Multiple Choice needs at least one. Leave any unused option rows blank.
    </p>

    <%= form.fields_for :options do |option_form| %>
      <div class="flex items-start gap-3 border border-slate-200 rounded-lg p-3">
        <div class="pt-2.5">
          <%= option_form.check_box :correct, class: "h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer" %>
        </div>
        <div class="flex-1 space-y-2">
          <%= option_form.text_field :option_text, placeholder: "Option text", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
          <%= option_form.text_field :explanation, placeholder: "Explanation shown after answering (optional)", class: "w-full rounded-lg border border-slate-200 px-3 py-2 text-xs text-slate-600" %>
        </div>
        <% if option_form.object.persisted? %>
          <label class="flex items-center gap-1.5 text-xs text-rose-600 pt-2.5 shrink-0">
            <%= option_form.check_box :_destroy, class: "h-3.5 w-3.5" %> Remove
          </label>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-5 border-t border-slate-200">
    <%= link_to "Cancel", teacher_slide_path(slide_question.slide), class: "px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors shadow-sm" %>
    <%= form.submit class: "px-5 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors shadow-sm cursor-pointer" %>
  </div>
<% end %>
