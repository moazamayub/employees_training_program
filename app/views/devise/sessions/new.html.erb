<div class="flex min-h-screen w-full flex-col lg:flex-row bg-slate-50 font-sans text-slate-800 antialiased">
  
  <div class="relative flex flex-col items-center justify-center overflow-hidden bg-gradient-to-br from-indigo-600 via-purple-600 to-cyan-500 p-8 lg:w-1/2 lg:p-12 text-white min-h-[280px] lg:min-h-screen">
    
    <div class="relative z-10 max-w-md text-center">
      <div class="mb-6 inline-flex rounded-2xl border border-white/25 bg-white/15 p-4 backdrop-blur-md shadow-lg">
        <svg class="h-12 w-12 stroke-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
      </div>
      <h1 class="text-2xl font-bold tracking-tight sm:text-4xl">Your App Name</h1>
      <p class="mt-3 hidden text-base text-white/85 sm:block sm:text-lg">
        Streamline your workflow with precision, security, and speed.
      </p>
    </div>

    <div class="absolute bottom-0 left-0 h-16 w-full overflow-hidden lg:h-28 z-0">
      <svg class="relative h-full w-full -mb-[7px]" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
        viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
        <defs>
          <path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z" />
        </defs>
        <g class="parallax">
          <use xlink:href="#gentle-wave" x="48" y="0" fill="rgba(255,255,255,0.7)" class="animate-wave-fast" />
          <use xlink:href="#gentle-wave" x="48" y="3" fill="rgba(255,255,255,0.5)" class="animate-wave-mid" />
          <use xlink:href="#gentle-wave" x="48" y="5" fill="rgba(255,255,255,0.3)" class="animate-wave-slow" />
          <use xlink:href="#gentle-wave" x="48" y="7" fill="#ffffff" class="animate-wave-slowest" />
        </g>
      </svg>
    </div>
  </div>

  <div class="flex flex-1 items-center justify-center bg-white p-6 sm:p-12 lg:w-1/2">
    <div class="w-full max-w-md">
      
      <div class="mb-8">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Welcome back</h2>
        <p class="mt-2 text-sm text-slate-500">Please enter your credentials to access your account.</p>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        
        <div>
          <%= f.label :email, "Email address", class: "block text-sm font-medium text-slate-700" %>
          <div class="mt-1.5">
            <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
                placeholder: "name@company.com",
                class: "block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-slate-900 placeholder-slate-400 shadow-sm transition focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 text-sm" %>
          </div>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-slate-700" %>
          <div class="mt-1.5">
            <%= f.password_field :password, autocomplete: "current-password", required: true,
                placeholder: "••••••••",
                class: "block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-slate-900 placeholder-slate-400 shadow-sm transition focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 text-sm" %>
          </div>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" %>
            <%= f.label :remember_me, "Remember me for 30 days", class: "ml-2.5 block text-sm text-slate-600 cursor-pointer" %>
          </div>
        <% end %>

        <div>
          <%= f.submit "Sign in", class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 active:scale-[0.99] transition duration-150" %>
        </div>
      <% end %>

      <div class="mt-8 border-t border-slate-100 pt-6 text-center text-sm text-slate-500 [&_a]:font-medium [&_a]:text-indigo-600 hover:[&_a]:text-indigo-800 hover:[&_a]:underline [&_a]:block [&_a]:my-1">
        <%= render "devise/shared/links" %>
      </div>

    </div>
  </div>
</div>




