
<!-- Enrolled Courses Section -->
  <section class="courses-section">
    <h2>My Enrolled Courses</h2>
    <% if @user_courses.any? %>
      <table class="table">
        <thead>
          <tr>
            <th>Course Title</th>
            <th>Status</th>
            <th>Progress</th>
            <th>Score</th>
            <th>Enrolled Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @user_courses.each do |user_course| %>
            <tr>
              <td><strong><%= user_course.course.title %></strong></td>
              <td><%= user_course.status.titleize %></td>
              <td><%= number_to_percentage(user_course.progress_percentage || 0, precision: 0) %></td>
              <td>
                <%= user_course.score.present? ? "#{user_course.score}%" : "Not Graded" %>
              </td>
              <td><%= user_course.enrolled_at&.strftime("%b %d, %Y") || user_course.created_at.strftime("%b %d, %Y") %></td>
              <td>
                <%= link_to "Continue Learning", course_path(user_course.course), class: "btn btn-primary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>You are not currently enrolled in any courses.</p>
    <% end %>
  </section>
</div>