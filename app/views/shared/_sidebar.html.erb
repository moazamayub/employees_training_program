<aside class="w-64 bg-blue-900 text-white min-h-screen flex flex-col justify-between shrink-0 border-r border-blue-950">
  <div class="p-4 space-y-6">
    <!-- App Brand -->
    <div class="flex items-center gap-2.5 px-3 py-2 border-b border-blue-800/80">
      <div class="h-8 w-8 rounded-lg bg-white flex items-center justify-center text-blue-900 font-bold text-lg shadow-sm">
        E
      </div>
      <div>
        <h2 class="text-sm font-bold tracking-tight text-white leading-tight">Training LMS</h2>
        <span class="text-xs text-blue-200 capitalize"><%= current_user.role %> Portal</span>
      </div>
    </div>

    <!-- Navigation Menu Items -->
    <nav class="space-y-1">
      <% if current_user.admin? %>
        <!-- Admin Navigation -->
        <p class="px-3 text-xs font-semibold text-blue-300 uppercase tracking-wider mb-2">Management</p>
        
        <%= link_to admin_companies_path, class: sidebar_link_class(admin_companies_path) do %>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          <span>Companies</span>
        <% end %>

      <% elsif current_user.teacher? %>
        <!-- Teacher Navigation -->
        <p class="px-3 text-xs font-semibold text-blue-300 uppercase tracking-wider mb-2">Instructor Hub</p>

        <%= link_to teacher_courses_path, class: sidebar_link_class(teacher_courses_path) do %>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span>Courses & Rosters</span>
        <% end %>

      <% else %>
        <!-- Student Navigation -->
        <p class="px-3 text-xs font-semibold text-blue-300 uppercase tracking-wider mb-2">My Learning</p>

        <%= link_to student_courses_path, class: sidebar_link_class(student_courses_path) do %>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Assigned Courses</span>
        <% end %>
      <% end %>
    </nav>
  </div>

  <!-- Bottom Session / Profile Footer -->
  <div class="p-4 border-t border-blue-800 bg-blue-950/40">
    <div class="flex items-center justify-between">
      <div class="truncate mr-2">
        <p class="text-xs font-medium text-white truncate"><%= current_user.email %></p>
        <p class="text-[11px] text-blue-300 capitalize"><%= current_user.role %></p>
      </div>
      <%= button_to destroy_user_session_path, method: :delete, title: "Sign Out", class: "p-1.5 text-blue-300 hover:text-white hover:bg-blue-800/80 rounded-md transition-colors" do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
      <% end %>
    </div>
  </div>
</aside>