<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-2xl mx-auto">
    <%= link_to "← Back to #{@company.name}", admin_company_path(@company), class: "text-xs font-semibold text-blue-600 hover:text-blue-800 uppercase tracking-wider" %>
    <h1 class="text-2xl font-bold text-blue-950 mt-1 mb-6">Add Teacher / Student to <%= @company.name %></h1>
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
      <%= render "form", user: @user %>
    </div>
  </div>
</div>
