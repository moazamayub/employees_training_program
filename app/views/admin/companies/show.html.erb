<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-5xl mx-auto space-y-6">
    <!-- Top Action Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-5 border-b border-blue-100 gap-4">
      <div>
        <%= link_to "← Back to Directory", admin_companies_path, class: "text-xs font-semibold text-blue-600 hover:text-blue-800 uppercase tracking-wider" %>
        <h1 class="text-3xl font-bold text-blue-950 mt-1"><%= @company.name %></h1>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to "Edit Company", edit_admin_company_path(@company), class: "px-4 py-2 text-sm font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg transition-colors" %>
        <%= link_to "Delete", admin_company_path(@company), data: { turbo_method: :delete, turbo_confirm: "Permanently delete this company and all its related records?" }, class: "px-4 py-2 text-sm font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-lg transition-colors" %>
      </div>
    </div>

    <!-- Company Details Card -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
      <h3 class="text-lg font-semibold text-blue-950 mb-4">Organization Overview</h3>
      <dl class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div>
          <dt class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Company ID</dt>
          <dd class="mt-1 text-sm font-mono text-slate-800">#<%= @company.id %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</dt>
          <dd class="mt-1">
            <% if @company.is_active? %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">Active</span>
            <% else %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200">Inactive</span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Registered Since</dt>
          <dd class="mt-1 text-sm text-slate-800"><%= @company.created_at.strftime("%B %d, %Y") %></dd>
        </div>
      </dl>
    </div>

    <!-- Associated Members / Employees -->
    <% if defined?(@users) %>
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <h3 class="text-lg font-semibold text-blue-950 mb-4 flex items-center justify-between">
          <span>Assigned Personnel (<%= @users.count %>)</span>
          <%= link_to "Manage →", admin_company_users_path(@company), class: "text-xs font-semibold text-blue-600 hover:text-blue-800" %>
        </h3>
        <% if @users.present? %>
          <div class="divide-y divide-slate-100">
            <% @users.each do |user| %>
              <div class="py-3 flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-slate-900"><%= [user.first_name, user.last_name].compact.join(" ").presence || user.email %></p>
                  <p class="text-xs text-slate-500"><%= user.email %></p>
                </div>
                <span class="text-xs px-2.5 py-1 rounded bg-slate-100 text-slate-700 font-medium">
                  <%= user.role&.titleize %>
                </span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-slate-500">No teachers or students assigned yet.</p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>