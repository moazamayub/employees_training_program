<div class="admin-container">
  <h1>Registered Companies</h1>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Active Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @companies.each do |company| %>
        <tr>
          <td><%= company.id %></td>
          <td><%= company.name %></td>
          <td><%= company.is_active? ? "Active" : "Inactive" %></td>
          <td>
            <%= link_to "View Details", admin_company_path(company) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>