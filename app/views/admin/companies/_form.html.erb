<%= form_with(model: [:admin, company], class: "space-y-6") do |form| %>
  <% if company.errors.any? %>
    <div class="rounded-xl bg-rose-50 border border-rose-200 p-4 mb-6">
      <div class="flex items-center gap-2">
        <svg class="h-5 w-5 text-rose-600" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
        </svg>
        <h3 class="text-sm font-semibold text-rose-800">
          <%= pluralize(company.errors.count, "error") %> prohibited this company from saving:
        </h3>
      </div>
      <ul class="mt-2 ml-7 list-disc text-xs text-rose-700 space-y-1">
        <% company.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Company Name", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= form.text_field :name, placeholder: "e.g. Acme Corporation", class: "w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= form.check_box :is_active, class: "h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" %>
    <%= form.label :is_active, "Active status (allows employees and teachers access to portal)", class: "text-sm text-slate-700 select-none cursor-pointer" %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-5 border-t border-slate-200">
    <%= link_to "Cancel", admin_companies_path, class: "px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors shadow-sm" %>
    <%= form.submit class: "px-5 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors shadow-sm cursor-pointer" %>
  </div>
<% end %>